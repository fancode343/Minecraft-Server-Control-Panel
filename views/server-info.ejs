  <div id="chatContainer" class="chat-container">
    <div class="chat-header">
      <h5>Chat</h5>
      <button id="closeChatButton" class="close-chat">✖</button>
    </div>
    <div id="chatMessages" class="chat-messages"></div>
    <div class="chat-input-container">
