<script>
  async function logActivity(action) {
   // Generate a UTC+8 timestamp
   const options = { timeZone: "Asia/Shanghai", hour12: false };
   const formatter = new Intl.DateTimeFormat("en-US", {
     ...options,
     year: "numeric",
     month: "2-digit",
     day: "2-digit",
     hour: "2-digit",
     minute: "2-digit",
     second: "2-digit",
   });
 
   const utc8Date = new Date();
   const [datePart, timePart] = formatter.format(utc8Date).split(", ");
   const [month, day, year] = datePart.split("/"); // Extract parts of the date
   const timestamp = `${year}-${month}-${day}T${timePart}+08:00`; // Format as ISO 8601
 
   const payload = {
     user: "<%= username %>", // Replace with dynamic username if needed
     action,
     timestamp,
   };
 
   console.log("Payload to be sent:", payload); // Debugging
 
   try {
     const response = await fetch(`/activity-log`, {     //Bugo jud ning ChatGPT Ga lisod lisod ra sa kinabuhi nag http://localhost:3000 pajud hays
       method: "POST",
       headers: {
         "Content-Type": "application/json",
       },
       body: JSON.stringify(payload),
     });
 
     if (!response.ok) {
       const errorData = await response.json();
       console.error("Failed to log activity:", errorData.error);
     } else {
       console.log("Activity logged:", payload);
     }
   } catch (error) {
     console.error("Error logging activity:", error);
   }
 }
 
 </script>
