          </div>
        </div>

        <!-- Chat & Scripting -->
        <div class="property-card">
          <h4>💬 Chat & Scripting</h4>
          <div class="form-group-modern">
            <label for="chat-restriction">Chat Restriction</label>
            <select id="chat-restriction" name="chat-restriction">
              <option value="None" <%= properties['chat-restriction'] === 'None' ? 'selected' : '' %>>None</option>
              <option value="Muted" <%= properties['chat-restriction'] === 'Muted' ? 'selected' : '' %>>Muted</option>
              <option value="Restricted" <%= properties['chat-restriction'] === 'Restricted' ? 'selected' : '' %>>Restricted</option>
            </select>
          </div>
          <div class="form-group-modern">
            <label>Allow Outbound Script Debugging</label>
            <div class="toggle-group">
              <button type="button" class="toggle-btn <%= properties['allow-outbound-script-debugging'] === 'true' ? 'active' : '' %>" data-toggle="allow-outbound-script-debugging" data-value="true">ON</button>
              <button type="button" class="toggle-btn <%= properties['allow-outbound-script-debugging'] !== 'true' ? 'active' : '' %>" data-toggle="allow-outbound-script-debugging" data-value="false">OFF</button>
            </div>
            <input type="hidden" id="allow-outbound-script-debugging" name="allow-outbound-script-debugging" value="<%= properties['allow-outbound-script-debugging'] || 'false' %>">
          </div>
          <div class="form-group-modern">
            <label>Allow Inbound Script Debugging</label>
            <div class="toggle-group">
              <button type="button" class="toggle-btn <%= properties['allow-inbound-script-debugging'] === 'true' ? 'active' : '' %>" data-toggle="allow-inbound-script-debugging" data-value="true">ON</button>
              <button type="button" class="toggle-btn <%= properties['allow-inbound-script-debugging'] !== 'true' ? 'active' : '' %>" data-toggle="allow-inbound-script-debugging" data-value="false">OFF</button>
            </div>
            <input type="hidden" id="allow-inbound-script-debugging" name="allow-inbound-script-debugging" value="<%= properties['allow-inbound-script-debugging'] || 'false' %>">
          </div>
          <div class="form-group-modern">
            <label for="script-debugger-auto-attach">Script Debugger Auto Attach</label>
            <select id="script-debugger-auto-attach" name="script-debugger-auto-attach">
              <option value="disabled" <%= properties['script-debugger-auto-attach'] === 'disabled' ? 'selected' : '' %>>Disabled</option>
              <option value="enabled" <%= properties['script-debugger-auto-attach'] === 'enabled' ? 'selected' : '' %>>Enabled</option>
            </select>
          </div>
        </div>

        <!-- Client & Network -->
        <div class="property-card">
          <h4>🌍 Client & Network</h4>
          <div class="form-group-modern">
            <label>Client Side Chunk Generation Enabled</label>
            <div class="toggle-group">
              <button type="button" class="toggle-btn <%= properties['client-side-chunk-generation-enabled'] === 'true' ? 'active' : '' %>" data-toggle="client-side-chunk-generation-enabled" data-value="true">ON</button>
              <button type="button" class="toggle-btn <%= properties['client-side-chunk-generation-enabled'] !== 'true' ? 'active' : '' %>" data-toggle="client-side-chunk-generation-enabled" data-value="false">OFF</button>
            </div>
            <input type="hidden" id="client-side-chunk-generation-enabled" name="client-side-chunk-generation-enabled" value="<%= properties['client-side-chunk-generation-enabled'] || 'true' %>">
          </div>
          <div class="form-group-modern">
            <label>Block Network IDs Are Hashes</label>
            <div class="toggle-group">
              <button type="button" class="toggle-btn <%= properties['block-network-ids-are-hashes'] === 'true' ? 'active' : '' %>" data-toggle="block-network-ids-are-hashes" data-value="true">ON</button>
              <button type="button" class="toggle-btn <%= properties['block-network-ids-are-hashes'] !== 'true' ? 'active' : '' %>" data-toggle="block-network-ids-are-hashes" data-value="false">OFF</button>
            </div>
            <input type="hidden" id="block-network-ids-are-hashes" name="block-network-ids-are-hashes" value="<%= properties['block-network-ids-are-hashes'] || 'true' %>">
          </div>
          <div class="form-group-modern">
            <label for="server-build-radius-ratio">Server Build Radius Ratio</label>
            <select id="server-build-radius-ratio" name="server-build-radius-ratio">
              <option value="Disabled" <%= properties['server-build-radius-ratio'] === 'Disabled' ? 'selected' : '' %>>Disabled</option>
              <option value="Limited" <%= properties['server-build-radius-ratio'] === 'Limited' ? 'selected' : '' %>>Limited</option>
              <option value="Unlimited" <%= properties['server-build-radius-ratio'] === 'Unlimited' ? 'selected' : '' %>>Unlimited</option>
            </select>
          </div>
        </div>

      </div>
    </form>
  </div>

  <script>
    // Handle toggle buttons
    document.querySelectorAll('.toggle-btn').forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const fieldName = this.dataset.toggle;
        const value = this.dataset.value;
        
        // Update the hidden input value
        document.getElementById(fieldName).value = value;
        
        // Update button states
        const siblings = this.parentElement.querySelectorAll('.toggle-btn');
        siblings.forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');
      });
    });
  </script>

  <div id="chatContainer" class="chat-container">
    <div class="chat-header">
      <h5>Chat</h5>
      <button id="closeChatButton" class="close-chat">✖</button>
    </div>
    <div id="chatMessages" class="chat-messages"></div>
    <div class="chat-input-container">
      <textarea id="chatInput" rows="2" placeholder="Type a message..."></textarea>
      <button id="sendMessageButton">Send</button>
    </div>
  </div>
  <button id="chatToggle" class="chat-toggle">💬</button>
  
  <%- include("../assets/chatAssets/chat1.js") %>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script>
    $(document).ready(function() {
      $("#properties-form").on("submit", function(e) {
        e.preventDefault(); // Prevent form from submitting normally

        const formData = $(this).serialize(); // Collect form data

        $.ajax({
          url: "/editserver-properties",
          method: "POST",
          data: formData,       
          success: function(response) {
            logActivity(`${formData}`)
            const messageDiv = $("#message");
            if (response.success) {
              messageDiv
                .text(response.message)
                .addClass("alert-success")
                .removeClass("alert-danger")
                .slideDown();
            } else {
              messageDiv
                .text(response.message)
                .addClass("alert-danger")
                .removeClass("alert-success")
                .slideDown();
            }
          },
          error: function() {
            $("#message")
              .text("An unexpected error occurred.")
              .addClass("alert-danger")
              .removeClass("alert-success")
              .slideDown();
          }
        });
      });
    });
  </script>
</body>
</html>