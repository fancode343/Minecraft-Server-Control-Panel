<!DOCTYPE html>
<html lang="en">
 <%- include("../assets/head") %> 
  <style>
    .properties-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .property-card {
      background: rgba(15, 23, 42, 0.82);
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 18px;
      padding: 1.5rem;
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.18);
    }

    .property-card h4 {
      color: rgba(255, 255, 255, 0.9);
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .form-group-modern {
      margin-bottom: 1.2rem;
    }

    .form-group-modern label {
      display: block;
      color: rgba(255, 255, 255, 0.85);
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 0.6rem;
    }

    .form-group-modern input[type="text"],
    .form-group-modern input[type="number"],
    .form-group-modern select {
      width: 100%;
      padding: 0.85rem;
      border: 1px solid rgba(148, 163, 184, 0.22);
      border-radius: 10px;
      background: rgba(15, 23, 42, 0.78);
      color: white;
      font-size: 0.95rem;
      transition: all 0.3s ease;
    }

    .form-group-modern input:focus,
    .form-group-modern select:focus {
      border-color: rgba(102, 126, 234, 0.6);
      background: rgba(15, 23, 42, 0.88);
      box-shadow: 0 0 12px rgba(102, 126, 234, 0.3);
    }

    .toggle-group {
      display: flex;
      gap: 0.8rem;
    }

    .toggle-btn {
      flex: 1;
      padding: 0.8rem;
      border: 2px solid rgba(148, 163, 184, 0.3);
      border-radius: 10px;
      background: rgba(15, 23, 42, 0.78);
      color: rgba(255, 255, 255, 0.6);
      cursor: pointer;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .toggle-btn.active {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-color: rgba(102, 126, 234, 0.6);
      color: white;
      box-shadow: 0 0 12px rgba(102, 126, 234, 0.3);
    }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(148, 163, 184, 0.12);
      width: 100%;
      min-height: 62px;
    }

    .page-header h1 {
      margin: 0;
      font-size: clamp(2rem, 3vw, 2.7rem);
      font-weight: 700;
      color: var(--text);
      min-width: 0;
      flex: 1 1 auto;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .save-btn {
      background: linear-gradient(135deg, var(--success), #10b981);
      color: #03140d;
      padding: 1rem 2rem;
      border: none;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(52, 211, 153, 0.4);
      white-space: nowrap;
      flex-shrink: 0;
      margin-left: 1rem;
    }

    @media (max-width: 767px) {
      .page-header {
        flex-direction: column;
        align-items: stretch;
      }

      .page-header h1 {
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
      }

      .save-btn {
        width: 100%;
        margin-left: 0;
      }
    }

    .save-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(52, 211, 153, 0.6);
    }

    #message {
      padding: 1rem;
      border-radius: 12px;
      margin-bottom: 1.5rem;
      display: none;
      backdrop-filter: blur(5px);
      animation: slideDown 0.3s ease-out;
    }

    #message.success {
      background: rgba(52, 211, 153, 0.15);
      border: 1px solid rgba(52, 211, 153, 0.5);
      color: #90ee90;
    }

    #message.error {
      background: rgba(248, 215, 218, 0.15);
      border: 1px solid rgba(248, 215, 218, 0.5);
      color: #ffb3b3;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
<body>
<%- include("../assets/nav") %> 

<script>
  async function logActivity(action) {
   const options = { timeZone: "Asia/Shanghai", hour12: false };
   const formatter = new Intl.DateTimeFormat("en-US", {
     ...options,
     year: "numeric",
     month: "2-digit",
     day: "2-digit",
     hour: "2-digit",
     minute: "2-digit",
     second: "2-digit",
   });
 
   const utc8Date = new Date();
   const [datePart, timePart] = formatter.format(utc8Date).split(", ");
   const [month, day, year] = datePart.split("/");
   const timestamp = `${year}-${month}-${day}T${timePart}+08:00`;
 
   const payload = {
     user: "<%= username %>",
     action,
     timestamp,
   };
 
   try {
     await fetch("/activity-log", {
       method: "POST",
       headers: { "Content-Type": "application/json" },
       body: JSON.stringify(payload),
     });
   } catch (error) {
     console.error("Error logging activity:", error);
   }
 }
</script>

