<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta property="og:title" content="EPSTEINSMP PANEL">
  <link rel="shortcut icon" href="assets/logo.png" sizes="196x196" type="image/png">
  <meta name="description" content="EpsteinSMP ControlPanel, Control And Manage The Server>
  <meta name="author" content="EpsteinSMP">
  <meta name="robots" content="noindex, nofollow">
  <meta property="og:image" content="/assets/content.jpg">
  <meta name="googlebot" content="noindex">
  <meta property="og:site_name" content="EPSTIENSMP">
  <title>Control Panel</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <style>
    body {
      font-family: Arial, sans-serif;
    }
    #message {
      margin: 10px 0;
      padding: 10px;
      border: 1px solid #ccc;
      background-color: #f0f0f0;
      display: none;
    }
    #message.success { border-color: green; color: green; }
    #message.error { border-color: red; color: red; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top mb-4">
  <a class="navbar-brand" href="#">EpsteinSMP</a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div class="collapse navbar-collapse" id="navbarNav">
    <ul class="navbar-nav mr-auto">
      <li class="nav-item"><a class="nav-link" href="/panel">Panel</a></li>
      <li class="nav-item"><a class="nav-link" href="/bots-panel">Bots</a></li>
      <li class="nav-item"><a class="nav-link" href="/command-center">Command</a></li>
      <li class="nav-item"><a class="nav-link" href="/editserver-properties">Edit Server Properties</a></li>
    </ul>
    <ul class="navbar-nav ml-auto">
      <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <i class="fa fa-user-circle"></i> <%= username %>
        </a>
        <div class="dropdown-menu dropdown-menu-right bg-dark text-white" aria-labelledby="navbarDropdown">
          <a class="dropdown-item text-white" href="?p=&settings=1">Settings</a>
          <a class="dropdown-item text-white" href="?p=&help=2">Help</a>
          <a class="dropdown-item text-white" href="/logout">Sign Out</a>
        </div>
      </li>
    </ul>
  </div>
</nav>

  <div class="container mt-5">
    <h1 class="mt-4">Edit Server Properties</h1>
    <div id="message" class="alert"></div>

    <form id="properties-form">
      <% for (const key in properties) { %>
        <div class="form-group">
          <label for="<%= key %>"><%= key %>:</label>
          <input type="text" class="form-control" id="<%= key %>" name="<%= key %>" value="<%= properties[key] %>">
        </div>
      <% } %>
      <button type="submit" class="btn btn-primary">Save</button>
    </form>
  </div>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script>
    $(document).ready(function() {
      $("#properties-form").on("submit", function(e) {
        e.preventDefault(); // Prevent form from submitting normally

        const formData = $(this).serialize(); // Collect form data

        $.ajax({
          url: "/editserver-properties",
          method: "POST",
          data: formData,
          success: function(response) {
            const messageDiv = $("#message");
            if (response.success) {
              messageDiv
                .text(response.message)
                .addClass("alert-success")
                .removeClass("alert-danger")
                .slideDown();
            } else {
              messageDiv
                .text(response.message)
                .addClass("alert-danger")
                .removeClass("alert-success")
                .slideDown();
            }
          },
          error: function() {
            $("#message")
              .text("An unexpected error occurred.")
              .addClass("alert-danger")
              .removeClass("alert-success")
              .slideDown();
          }
        });
      });
    });
  </script>
</body>
</html>