  <div class="container" style="max-width: 1400px; padding-top: 2rem; padding-bottom: 3rem;">
    <div class="page-header">
      <h1>Server Properties</h1>
      <button type="submit" form="properties-form" class="save-btn">💾 Save Changes</button>
    </div>
    
    <div id="message" class="alert"></div>

    <form id="properties-form">
      <div class="properties-grid">
        
        <!-- Server Information -->
        <div class="property-card">
          <h4>📋 Server Information</h4>
          <div class="form-group-modern">
            <label for="server-name">Server Name</label>
            <input type="text" id="server-name" name="server-name" value="<%= properties['server-name'] || 'Dedicated Server' %>">
          </div>
          <div class="form-group-modern">
            <label for="max-players">Max Players</label>
            <input type="number" id="max-players" name="max-players" value="<%= properties['max-players'] || 10 %>" min="1" max="9999">
          </div>
        </div>

        <!-- Gameplay -->
        <div class="property-card">
          <h4>🎮 Gameplay</h4>
          <div class="form-group-modern">
            <label for="gamemode">Game Mode</label>
            <select id="gamemode" name="gamemode">
              <option value="survival" <%= properties['gamemode'] === 'survival' ? 'selected' : '' %>>Survival</option>
              <option value="creative" <%= properties['gamemode'] === 'creative' ? 'selected' : '' %>>Creative</option>
              <option value="adventure" <%= properties['gamemode'] === 'adventure' ? 'selected' : '' %>>Adventure</option>
              <option value="hardcore" <%= properties['gamemode'] === 'hardcore' ? 'selected' : '' %>>Hardcore</option>
            </select>
          </div>
          <div class="form-group-modern">
            <label for="difficulty">Difficulty</label>
            <select id="difficulty" name="difficulty">
              <option value="peaceful" <%= properties['difficulty'] === 'peaceful' ? 'selected' : '' %>>Peaceful</option>
              <option value="easy" <%= properties['difficulty'] === 'easy' ? 'selected' : '' %>>Easy</option>
              <option value="normal" <%= properties['difficulty'] === 'normal' ? 'selected' : '' %>>Normal</option>
              <option value="hard" <%= properties['difficulty'] === 'hard' ? 'selected' : '' %>>Hard</option>
            </select>
          </div>
        </div>

        <!-- Game Rules -->
        <div class="property-card">
          <h4>⚙️ Game Rules</h4>
          <div class="form-group-modern">
            <label>Force Game Mode</label>
            <div class="toggle-group">
              <button type="button" class="toggle-btn <%= properties['force-gamemode'] === 'true' ? 'active' : '' %>" data-toggle="force-gamemode" data-value="true">ON</button>
              <button type="button" class="toggle-btn <%= properties['force-gamemode'] !== 'true' ? 'active' : '' %>" data-toggle="force-gamemode" data-value="false">OFF</button>
            </div>
            <input type="hidden" id="force-gamemode" name="force-gamemode" value="<%= properties['force-gamemode'] || 'false' %>">
          </div>
          <div class="form-group-modern">
            <label>Allow Cheats</label>
            <div class="toggle-group">
              <button type="button" class="toggle-btn <%= properties['allow-cheats'] === 'true' ? 'active' : '' %>" data-toggle="allow-cheats" data-value="true">ON</button>
              <button type="button" class="toggle-btn <%= properties['allow-cheats'] !== 'true' ? 'active' : '' %>" data-toggle="allow-cheats" data-value="false">OFF</button>
            </div>
            <input type="hidden" id="allow-cheats" name="allow-cheats" value="<%= properties['allow-cheats'] || 'false' %>">
          </div>
        </div>

        <!-- Network -->
        <div class="property-card">
          <h4>🌐 Network</h4>
          <div class="form-group-modern">
            <label for="server-port">Server Port (IPv4)</label>
            <input type="number" id="server-port" name="server-port" value="<%= properties['server-port'] || 19132 %>" min="1" max="65535">
          </div>
          <div class="form-group-modern">
            <label for="server-portv6">Server Port (IPv6)</label>
            <input type="number" id="server-portv6" name="server-portv6" value="<%= properties['server-portv6'] || 19133 %>" min="1" max="65535">
          </div>
          <div class="form-group-modern">
            <label>Online Mode</label>
            <div class="toggle-group">
              <button type="button" class="toggle-btn <%= properties['online-mode'] === 'true' ? 'active' : '' %>" data-toggle="online-mode" data-value="true">ON</button>
              <button type="button" class="toggle-btn <%= properties['online-mode'] !== 'true' ? 'active' : '' %>" data-toggle="online-mode" data-value="false">OFF</button>
            </div>
            <input type="hidden" id="online-mode" name="online-mode" value="<%= properties['online-mode'] || 'true' %>">
          </div>
        </div>

        <!-- Security & Access -->
        <div class="property-card">
          <h4>🔐 Security & Access</h4>
          <div class="form-group-modern">
            <label>Allow List</label>
            <div class="toggle-group">
              <button type="button" class="toggle-btn <%= properties['allow-list'] === 'true' ? 'active' : '' %>" data-toggle="allow-list" data-value="true">ON</button>
              <button type="button" class="toggle-btn <%= properties['allow-list'] !== 'true' ? 'active' : '' %>" data-toggle="allow-list" data-value="false">OFF</button>
            </div>
            <input type="hidden" id="allow-list" name="allow-list" value="<%= properties['allow-list'] || 'true' %>">
          </div>
          <div class="form-group-modern">
            <label>Enable LAN Visibility</label>
            <div class="toggle-group">
              <button type="button" class="toggle-btn <%= properties['enable-lan-visibility'] === 'true' ? 'active' : '' %>" data-toggle="enable-lan-visibility" data-value="true">ON</button>
              <button type="button" class="toggle-btn <%= properties['enable-lan-visibility'] !== 'true' ? 'active' : '' %>" data-toggle="enable-lan-visibility" data-value="false">OFF</button>
            </div>
            <input type="hidden" id="enable-lan-visibility" name="enable-lan-visibility" value="<%= properties['enable-lan-visibility'] || 'true' %>">
          </div>
        </div>

        <!-- Advanced -->
        <div class="property-card">
          <h4>⚡ Advanced</h4>
          <div class="form-group-modern">
            <label for="level-name">Level Name</label>
            <input type="text" id="level-name" name="level-name" value="<%= properties['level-name'] || 'Bedrock level' %>" placeholder="Bedrock level">
          </div>
          <div class="form-group-modern">
            <label for="level-seed">Level Seed</label>
            <input type="text" id="level-seed" name="level-seed" value="<%= properties['level-seed'] || '' %>" placeholder="Optional seed">
          </div>
          <div class="form-group-modern">
            <label for="view-distance">View Distance</label>
            <input type="number" id="view-distance" name="view-distance" value="<%= properties['view-distance'] || 32 %>" min="5" step="1">
          </div>
          <div class="form-group-modern">
            <label for="transport">Transport</label>
            <input type="text" id="transport" name="transport" value="<%= properties['transport'] || 'default' %>" placeholder="e.g., default">
          </div>
        </div>

      </div>
    </form>
  </div>

  <script>
    // Handle toggle buttons
    document.querySelectorAll('.toggle-btn').forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const fieldName = this.dataset.toggle;
        const value = this.dataset.value;
        
        // Update the hidden input value
        document.getElementById(fieldName).value = value;
        
        // Update button states
        const siblings = this.parentElement.querySelectorAll('.toggle-btn');
        siblings.forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');
      });
    });
  </script>

  <div id="chatContainer" class="chat-container">
    <div class="chat-header">
      <h5>Chat</h5>
      <button id="closeChatButton" class="close-chat">✖</button>
    </div>
    <div id="chatMessages" class="chat-messages"></div>
    <div class="chat-input-container">
      <textarea id="chatInput" rows="2" placeholder="Type a message..."></textarea>
      <button id="sendMessageButton">Send</button>
    </div>
  </div>
  <button id="chatToggle" class="chat-toggle">💬</button>
  
  <%- include("../assets/chatAssets/chat1.js") %>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script>
    $(document).ready(function() {
      $("#properties-form").on("submit", function(e) {
        e.preventDefault(); // Prevent form from submitting normally

        const formData = $(this).serialize(); // Collect form data

        $.ajax({
          url: "/editserver-properties",
          method: "POST",
          data: formData,       
          success: function(response) {
            logActivity(`${formData}`)
            const messageDiv = $("#message");
            if (response.success) {
              messageDiv
                .text(response.message)
                .addClass("alert-success")
                .removeClass("alert-danger")
                .slideDown();
            } else {
              messageDiv
                .text(response.message)
                .addClass("alert-danger")
                .removeClass("alert-success")
                .slideDown();
            }
          },
          error: function() {
            $("#message")
              .text("An unexpected error occurred.")
              .addClass("alert-danger")
              .removeClass("alert-success")
              .slideDown();
          }
        });
      });
    });
  </script>
</body>
</html>