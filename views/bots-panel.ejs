

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta property="og:title" content="EPSTEINSMP PANEL">
  <link rel="shortcut icon" href="assets/logo.png" sizes="196x196" type="image/png">
  <meta name="description" content="EpsteinSMP ControlPanel, Control And Manage The Server>
  <meta name="author" content="EpsteinSMP">
  <meta name="robots" content="noindex, nofollow">
  <meta property="og:image" content="/assets/content.jpg">
  <meta name="googlebot" content="noindex">
  <meta property="og:site_name" content="EPSTIENSMP">
  <title>Control Panel</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="assets/chatAssets/chat.css">
  <style>
    #logs {
      width: 100%;
      height: 400px;
      overflow-y: scroll;
      background: #000;
      color: #0f0;
      padding: 10px;
      border: 1px solid #333;
      font-family: monospace;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top mb-4">
    <a class="navbar-brand" href="#">EpsteinSMP</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav mr-auto">
        <li class="nav-item"><a class="nav-link" href="/panel">Panel</a></li>
        <li class="nav-item"><a class="nav-link" href="/bots-panel">Bots</a></li>
        <li class="nav-item"><a class="nav-link" href="/command-center">Command</a></li>
        <li class="nav-item"><a class="nav-link" href="/editserver-properties">Edit Server Properties</a></li>
        <li class="nav-item"><a class="nav-link" href="/server-info">Server-info</a></li>
        <li class="nav-item"><a class="nav-link" href="/activitylogs">Activity-logs</a></li>
      </ul>
      <ul class="navbar-nav ml-auto">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fa fa-user-circle"></i> <%= username %>
          </a>
          <div class="dropdown-menu dropdown-menu-right bg-dark text-white" aria-labelledby="navbarDropdown">
            <a class="dropdown-item text-white" href="/panel?p=&settings=1">Settings</a>
            <a class="dropdown-item text-white" href="?p=&help=2">Help</a>
            <a class="dropdown-item text-white" href="/logout">Sign Out</a>
          </div>
        </li>
      </ul>
    </div>
  </nav>

  <div class="container mt-5">
    <h1>Welcome, <%= username %>!</h1>
    <div class="btn-group mb-4">
      <div class="d-flex align-items-center">
        <button id="startButton" class="btn btn-success">Start Server</button>
        <div id="startSpinner" class="spinner-border text-success ml-2" role="status" style="display: none;"></div>
        <span id="startCheck" class="text-success ml-2" style="display: none;">✔</span>
      </div>
      <div class="d-flex align-items-center ml-3">
        <button id="restartButton" class="btn btn-warning">Restart Server</button>
        <div id="restartSpinner" class="spinner-border text-warning ml-2" role="status" style="display: none;"></div>
        <span id="restartCheck" class="text-success ml-2" style="display: none;">✔</span>
      </div>
      <div class="d-flex align-items-center ml-3">
        <button id="stopButton" class="btn btn-danger">Stop Server</button>
        <div id="stopSpinner" class="spinner-border text-danger ml-2" role="status" style="display: none;"></div>
        <span id="stopCheck" class="text-success ml-2" style="display: none;">✔</span>
      </div>
    </div>

  
    <div class="header">
      <div class="avatar"></div>
      <h3>Manage Bots       <button class="btn btn-primary" data-toggle="modal" data-target="#botModal">Add Bot</button></h3>
    </div>
    <h4>__________________________</h4>
  
    <div id="botsList"></div>
  
    <!-- Modal for adding/editing a bot -->
    <div class="modal fade" id="botModal" tabindex="-1" role="dialog" aria-labelledby="botModalLabel" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="botModalLabel">Add Bot</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span>&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <div class="form-group">
              <label for="botNameInput">Bot Name</label>
              <input type="text" class="form-control" id="botNameInput" placeholder="Enter bot name">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            <button type="button" class="btn btn-primary" onclick="sendDataToBackend()">Save Bot</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="alertModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Notification</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p id="alertMessage"></p>
        </div>
        <div class="modal-footer">
          <button id="closeAlertModal" type="button" class="btn btn-primary">Close</button>
        </div>
      </div>
    </div>
  </div>
  


  <div class="modal fade" id="responseModal" tabindex="-1" aria-labelledby="responseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="responseModalLabel">Server Response</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body" id="responseModalBody"></div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <div id="chatContainer" class="chat-container">
    <div class="chat-header">
      <h5>Chat</h5>
      <button id="closeChatButton" class="close-chat">✖</button>
    </div>
    <div id="chatMessages" class="chat-messages"></div>
    <div class="chat-input-container">
      <textarea id="chatInput" rows="2" placeholder="Type a message..."></textarea>
      <button id="sendMessageButton">Send</button>
    </div>
  </div>
  <button id="chatToggle" class="chat-toggle">💬</button>
  
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // DOM elements
      const chatContainer = document.getElementById("chatContainer");
      const chatMessages = document.getElementById("chatMessages");
      const chatInput = document.getElementById("chatInput");
      const sendMessageButton = document.getElementById("sendMessageButton");
      const chatToggle = document.getElementById("chatToggle");
      const closeChatButton = document.getElementById("closeChatButton");
  
      // Username (replace with dynamic username logic if available)
      const username = "<%= username %>";
  
      // WebSocket connection
      const ws = new WebSocket("wss://gjrj.lmnet.cf/ws");
  
      // Helper function to append a message to the chat
      function appendMessage(user, message) {
        if (!chatMessages) {
          console.error("Chat messages container not found.");
          return;
        }
        const messageElement = document.createElement("div");
        messageElement.textContent = `${user}: ${message}`;
        chatMessages.appendChild(messageElement);
        scrollToBottom(); // Automatically scroll to the bottom
      }
  
      // Helper function to scroll to the bottom of the chat
      function scrollToBottom() {
        if (chatMessages) {
          chatMessages.scrollTop = chatMessages.scrollHeight;
        }
      }
  
      // Send a message
      function sendMessage() {
        const message = chatInput.value.trim();
        if (message) {
          const payload = { user: username, message };
          ws.send(JSON.stringify(payload)); // Send the message
          chatInput.value = ""; // Clear input field
        }
      }
  
      // WebSocket event: Handle incoming messages
      ws.onmessage = (event) => {
        console.log("WebSocket message received:", event.data);
        let data;
        try {
          data = JSON.parse(event.data);
        } catch (error) {
          console.error("Invalid JSON received from WebSocket:", event.data);
          return;
        }
  
        if (data.type === "history") {
          chatMessages.innerHTML = ""; // Clear existing messages
          data.data.forEach((msg) => appendMessage(msg.user, msg.message));
          scrollToBottom(); // Scroll to the bottom after loading history
        } else if (data.type === "message") {
          appendMessage(data.data.user, data.data.message);
          if (chatContainer.style.display === "none") {
            chatToggle.classList.add("new-message"); // Highlight toggle if hidden
          }
        }
      };
  
      // WebSocket event: Log errors
      ws.onerror = (error) => {
        console.error("WebSocket error:", error);
      };
  
      // WebSocket event: Log disconnection
      ws.onclose = () => {
        console.warn("WebSocket connection closed.");
      };
  
      // Event listener: Send message on button click
      sendMessageButton.addEventListener("click", sendMessage);
  
      // Event listener: Send message on Enter key press
      chatInput.addEventListener("keypress", (event) => {
        if (event.key === "Enter" && !event.shiftKey) {
          event.preventDefault(); // Prevent newline in the textarea
          sendMessage(); // Send the message
        }
      });
  
      // Event listener: Toggle chat container visibility
      chatToggle.addEventListener("click", () => {
        chatContainer.style.display = "flex";
        chatToggle.style.display = "none"; // Hide chat toggle
        chatToggle.classList.remove("new-message"); // Remove notification styling
        scrollToBottom(); // Scroll to the bottom on opening
      });
  
      // Event listener: Close chat container
      closeChatButton.addEventListener("click", () => {
        chatContainer.style.display = "none";
        chatToggle.style.display = "block"; // Show chat toggle
      });
    });
  </script>

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
 
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // Modal setup
      const alertModal = new bootstrap.Modal(document.getElementById("alertModal"));
      const responseModal = new bootstrap.Modal(document.getElementById("responseModal"));
      const logContainer = document.getElementById("logs");
  
      const showModal = (message) => {
        document.getElementById("responseModalBody").innerText = message;
        responseModal.show();
      };
  
      const alert = (message) => {
        const alertMessageElement = document.getElementById("alertMessage");
        alertMessageElement.textContent = message;
        alertModal.show();
      };
  
      const toggleLoading = (buttonId, spinnerId, checkId, isLoading) => {
        const button = document.getElementById(buttonId);
        const spinner = document.getElementById(spinnerId);
        const check = document.getElementById(checkId);
  
        if (isLoading) {
          button.disabled = true;
          spinner.style.display = "inline-block";
          check.style.display = "none";
        } else {
          button.disabled = false;
          spinner.style.display = "none";
          check.style.display = "inline-block";
  
          setTimeout(() => {
            check.style.display = "none";
          }, 5000);
        }
      };
  
      const sendServerAction = (buttonId, spinnerId, checkId, url, successMessage) => {
        toggleLoading(buttonId, spinnerId, checkId, true);
  
        fetch(url, { method: "POST" })
          .then((response) => response.text())
          .then((result) => {
            showModal(result);
            console.log(successMessage);
            toggleLoading(buttonId, spinnerId, checkId, false);
          })
          .catch((error) => {
            console.error("Error:", error);
            showModal("An error occurred while processing your request.");
            toggleLoading(buttonId, spinnerId, checkId, false);
          });
      };
  
      const fetchBots = () => {
        fetch('/api/bots/new')
          .then(response => {
            if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
            return response.json();
          })
          .then(bots => renderBots(bots))
          .catch(error => console.error('Error fetching bots:', error));
      };
  
      const renderBots = (bots) => {
        const botsList = document.getElementById('botsList');
        botsList.innerHTML = '';
  
        bots.forEach(bot => {
          const botElement = document.createElement('div');
          botElement.classList.add('bot');
          botElement.setAttribute('data-name', bot.name);
          botElement.innerHTML = `
            <h4>${bot.name}</h4>
            <p>Status: <span class="${bot.status === 'Online' ? 'text-success' : 'text-danger'}">${bot.status}</span></p>
            <button class="btn btn-warning" onclick="runBot('${bot.name}')">Run</button>
            <button class="btn btn-warning" onclick="stopBot('${bot.name}')">Stop</button>
            <button class="btn btn-danger" onclick="deleteBot('${bot.name}')">Delete</button>
          `;
          botsList.appendChild(botElement);
        });
      };
  
      // Add Bot functionality
      const sendDataToBackend = () => {
        const name = document.getElementById('botNameInput').value.trim();
        logActivity(`Create a bot - ${name}`)
        if (!name) {
          alert("Please enter a bot name.");
          return;
        }
        fetch("/api/bot/new", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name }),
        })
          .then(response => {
            if (!response.ok) {
              return response.json().then(error => {
                throw new Error(error.message || "Failed to add bot");
              });
            }
            return response.json();
          })
          .then(result => {
            alert(result.message || "Bot added successfully");
            fetchBots();
            $('#botModal').modal('hide');
          })
          .catch(error => {
            console.error("Error sending data:", error);
            alert("Failed to add bot. Check the console for details.");
          });
      };
  
      // Bot actions
  
      window.runBot = (botName) => {
        logActivity(`run bot - ${botName}`)
      fetch(`/api/bots/run/${botName}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      })
        .then(response => response.json())
        .then(data => {
          alert(data.message || 'Bot started successfully');
          fetchBots();
        })
        .catch(error => {
          console.error('Error running bot:', error);
          alert('Failed to start the bot.');
        });
    };

    window.stopBot = (botName) => {
      logActivity(`Stop bot - ${botName}`)
      fetch(`/api/bots/stop/${botName}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      })
        .then(response => response.json())
        .then(data => {
          alert(data.message || 'Bot stopped successfully');
          fetchBots();
        })
        .catch(error => {
          console.error('Error stopping bot:', error);
          alert('Failed to stop the bot.');
        });
    };

    window.deleteBot = (botName) => {
      logActivity(`Deleted bot - ${botName}`)
      fetch(`/api/bots/${botName}`, { method: 'DELETE' })
        .then(response => response.json())
        .then(data => {
          alert(data.message || 'Bot deleted successfully');
          fetchBots();
        })
        .catch(error => {
          console.error('Error deleting bot:', error);
          alert('Failed to delete the bot.');
        });
    };

    // Fetch bots initially and at intervals
    fetchBots();
    setInterval(fetchBots, 5000);
      // Event listeners for buttons
      document.getElementById("startButton").addEventListener("click", () => {
        sendServerAction("startButton", "startSpinner", "startCheck", "/start", "Starting server...");
        logActivity("Server Start")
      });
  
      document.getElementById("restartButton").addEventListener("click", () => {
        sendServerAction("restartButton", "restartSpinner", "restartCheck", "/restart", "Restarting server...");
        logActivity("Server Restart")
      });
  
      document.getElementById("stopButton").addEventListener("click", () => {
        sendServerAction("stopButton", "stopSpinner", "stopCheck", "/stop", "Stopping server...");
        logActivity("Server Stop")
      });
  
      document.getElementById('closeAlertModal').addEventListener('click', () => alertModal.hide());
      document.getElementById('botNameInput').addEventListener('change', sendDataToBackend);
  
      // Fetch bots at intervals
      fetchBots();
      setInterval(fetchBots, 5000);
    });
  </script>


<script>
  async function logActivity(action) {
   // Generate a UTC+8 timestamp
   const options = { timeZone: "Asia/Shanghai", hour12: false };
   const formatter = new Intl.DateTimeFormat("en-US", {
     ...options,
     year: "numeric",
     month: "2-digit",
     day: "2-digit",
     hour: "2-digit",
     minute: "2-digit",
     second: "2-digit",
   });
 
   const utc8Date = new Date();
   const [datePart, timePart] = formatter.format(utc8Date).split(", ");
   const [month, day, year] = datePart.split("/"); // Extract parts of the date
   const timestamp = `${year}-${month}-${day}T${timePart}+08:00`; // Format as ISO 8601
 
   const payload = {
     user: "<%= username %>", // Replace with dynamic username if needed
     action,
     timestamp,
   };
 
   console.log("Payload to be sent:", payload); // Debugging
 
   try {
     const response = await fetch("/activity-log", {
       method: "POST",
       headers: {
         "Content-Type": "application/json",
       },
       body: JSON.stringify(payload),
     });
 
     if (!response.ok) {
       const errorData = await response.json();
       console.error("Failed to log activity:", errorData.error);
     } else {
       console.log("Activity logged:", payload);
     }
   } catch (error) {
     console.error("Error logging activity:", error);
   }
 }
 
 </script>
  
</body>
</html>
