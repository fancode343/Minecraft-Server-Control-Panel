<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Panel ETSPM</title>
  <link rel="shortcut icon" href="assets/logo.png" sizes="196x196" type="image/png">
  <meta name="description" content="EpsteinSMP Control Panel - Manage your server safely and easily">
  <meta name="author" content="EpsteinSMP">
  <meta name="robots" content="noindex, nofollow">
  <meta name="googlebot" content="noindex">

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

  <style>
         body {
      margin: 0;
      padding: 0;
      font-family: 'Poppins', sans-serif;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #f5f5f5; /* Optional light background */
    }

    .login-container {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(12px);
      border-radius: 20px;
      padding: 40px;
      width: 360px;
      text-align: center;
      color: white;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
      animation: fadeIn 1.2s ease-in-out;
    }

    .login-container img {
      margin-bottom: 15px;
    }

    .login-container h2 {
      margin-bottom: 20px;
      font-size: 26px;
      font-weight: 600;
      color: #333;
    }

    .login-container input {
      width: 100%;
      padding: 12px 14px;
      margin: 10px 0;
      border-radius: 8px;
      outline: none;
      font-size: 16px;
      box-sizing: border-box;
    }

    .login-container input[type="text"],
    .login-container input[type="password"] {
      background: rgba(255, 255, 255, 0.95);
      color: #000000;
      border: 1.8px solid #ccc;
      transition: border 0.3s, box-shadow 0.3s;
    }

    .login-container input[type="text"]:focus,
    .login-container input[type="password"]:focus {
      border: 1.8px solid #667eea;
      box-shadow: 0 0 6px rgba(102, 126, 234, 0.4);
    }

    .login-container button {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 10px;
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
      font-size: 18px;
      cursor: pointer;
      margin-top: 15px;
      transition: 0.3s;
    }

    .login-container button:hover {
      background: linear-gradient(135deg, #5563c1, #5c3c8a);
    }

    .error-message {
      margin-top: 10px;
      color: #ff4d4d;
      font-size: 14px;
      font-weight: 600;
    }

    .extra {
      margin-top: 15px;
      font-size: 14px;
    }

    .extra a {
      color: #fff;
      text-decoration: none;
      font-weight: bold;
    }

    .footer {
      margin-top: 15px;
      font-size: 12px;
      color: #666;
    }

    .footer a {
      color: #555;
      text-decoration: none;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-30px); }
      to { opacity: 1; transform: translateY(0); }
    }


  </style>
</head>
<body>
  <div class="login-container">
    <!-- Logo -->
    <img src="/assets/logo.png" alt="Logo" width="150" height="150">
    <h2>Welcome Back</h2>

    <!-- Login Form -->
    <form method="post">
      <input type="text" name="username" placeholder="Username" required>
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Login</button>
    </form>

    <!-- Error Message (if any) -->
    <% if (typeof error !== "undefined") { %>
      <p class="error-message"><%= error %></p>
    <% } %>

    <!-- Footer -->
    <div class="footer">
      —— © <a href="https://lmnet.cf/" target="_blank">lmnet.cf - GGMC</a> ——
    </div>
  </div>
</body>
</html>
