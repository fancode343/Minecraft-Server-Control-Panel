<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= serverName || "Minecraft Server" %> - Login</title>
  <link rel="shortcut icon" href="assets/logo.png" sizes="196x196" type="image/png">
  <meta name="description" content="<%= serverName %> Control Panel - Manage your server safely and easily">
  <meta name="author" content="<%= serverName %>">
  <meta name="robots" content="noindex, nofollow">
  <meta name="googlebot" content="noindex">

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
      overflow: hidden;
    }

    .login-wrapper {
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    .login-container {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 20px;
      padding: 50px 40px;
      width: 100%;
      max-width: 420px;
      text-align: center;
      color: white;
      box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37);
      animation: slideUp 0.8s ease-out;
    }

    .login-header {
      margin-bottom: 30px;
    }

    .login-container img {
      width: 120px;
      height: 120px;
      margin-bottom: 20px;
      opacity: 0.9;
      transition: all 0.3s ease;
    }

    .login-container img:hover {
      opacity: 1;
      transform: scale(1.05);
    }

    .server-name {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 8px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .login-subtitle {
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.7);
      font-weight: 300;
    }

    .login-form {
      margin-top: 30px;
    }

    .form-group {
      margin-bottom: 18px;
      text-align: left;
    }

    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .login-container input {
      width: 100%;
      padding: 12px 15px;
      border-radius: 10px;
      outline: none;
      font-size: 15px;
      font-family: 'Poppins', sans-serif;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.08);
      color: white;
      transition: all 0.3s ease;
    }

    .login-container input::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .login-container input:focus {
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(102, 126, 234, 0.6);
      box-shadow: 0 0 12px rgba(102, 126, 234, 0.3);
    }

    .login-container button {
      width: 100%;
      padding: 13px;
      border: none;
      border-radius: 10px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 25px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .login-container button:hover {
      background: linear-gradient(135deg, #5563c1 0%, #5c3c8a 100%);
      box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
      transform: translateY(-2px);
    }

    .login-container button:active {
      transform: translateY(0);
    }

    .error-message {
      margin-top: 20px;
      padding: 12px 15px;
      background: rgba(255, 77, 77, 0.15);
      border-left: 4px solid #ff4d4d;
      border-radius: 8px;
      color: #ffb3b3;
      font-size: 14px;
      font-weight: 500;
      backdrop-filter: blur(5px);
      animation: shake 0.5s ease-in-out;
    }

    .footer {
      margin-top: 25px;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.5);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-top: 15px;
    }

    .footer a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .footer a:hover {
      color: white;
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
      20%, 40%, 60%, 80% { transform: translateX(5px); }
    }
  </style>
</head>
<body>
  <div class="login-wrapper">
    <div class="login-container">
      <div class="login-header">
        <img src="/assets/logo.png" alt="<%= serverName %> Logo">
        <div class="server-name"><%= serverName || "Minecraft Server" %></div>
        <div class="login-subtitle">Control Panel</div>
      </div>

      <form method="post" class="login-form">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" placeholder="Enter your username" required>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Enter your password" required>
        </div>
        <button type="submit">Sign In</button>
      </form>

      <% if (typeof error !== "undefined" && error) { %>
        <p class="error-message"><%= error %></p>
      <% } %>

      <div class="footer">
        <a href="https://lmnet.cf"> © 2026 learning minds network</a>
      </div>
    </div>
  </div>
</body>
</html>
  </div>
</body>
</html>
