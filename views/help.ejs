<!DOCTYPE html>
<html lang="en">
<%- include("../assets/head") %>
<body style="background: linear-gradient(135deg, #0f0c29, #302b63, #24243e); min-height: 100vh;">
<%- include("../assets/navSettings") %>

  <div class="container mt-5 pt-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 15px; padding: 40px; box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37);">
          <h1 style="color: #fff; font-weight: 700; margin-bottom: 10px; font-size: 2rem;">Help & Password Tool</h1>
          <h2 style="color: rgba(255, 255, 255, 0.7); font-size: 1.3rem; margin-bottom: 30px; font-weight: 300;">Generate a secure password hash</h2>

          <div style="margin-bottom: 25px;">
            <label for="plainPassword" style="color: rgba(255, 255, 255, 0.9); display: block; margin-bottom: 8px; font-weight: 600; font-size: 0.95rem;">Password</label>
            <input type="password" id="plainPassword" placeholder="Enter password to hash" style="width: 100%; padding: 12px 15px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; color: #fff; font-size: 0.95rem;" />
          </div>

          <button id="generateHashBtn" type="button" style="width: 100%; padding: 12px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); margin-bottom: 25px;">
            Generate Hash
          </button>

          <div style="margin-bottom: 20px;">
            <label for="hashedPassword" style="color: rgba(255, 255, 255, 0.9); display: block; margin-bottom: 8px; font-weight: 600; font-size: 0.95rem;">Generated Hash</label>
            <textarea id="hashedPassword" rows="6" readonly style="width: 100%; padding: 12px 15px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; color: #fff; font-size: 0.95rem; resize: vertical; font-family: monospace;"></textarea>
          </div>

          <div style="background: rgba(96, 165, 250, 0.12); border-left: 4px solid #60a5fa; color: #dbeafe; padding: 15px; border-radius: 8px;">
            <strong>Tip:</strong> Use this hash in your credentials file when setting a new password.
          </div>

          <hr style="border-color: rgba(255, 255, 255, 0.1); margin: 30px 0;">

          <h2 style="color: rgba(255, 255, 255, 0.7); font-size: 1.3rem; margin-bottom: 30px; margin-top: 30px; font-weight: 300;">Panel Server Management</h2>

          <button id="shutdownServerBtn" type="button" style="width: 100%; padding: 12px; background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);">
            ⚠️ Shutdown Panel Server
          </button>

          <div id="shutdownModal" class="custom-modal12" style="display: none;">
            <div class="custom-modal-content">
              <h3>Confirm Panel Shutdown</h3>
              <p style="color: rgba(255, 255, 255, 0.8); margin-bottom: 20px;">Are you sure you want to stop the Node.js control panel server?</p>
              <div class="d-flex justify-content-end gap-2">
                <button class="btn-cancel" id="cancelShutdown">Cancel</button>
                <button class="btn-submit" id="confirmShutdown" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">Shutdown</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script>
    // Password hash generator
    document.getElementById('generateHashBtn').addEventListener('click', async () => {
      const plain = document.getElementById('plainPassword').value;
      const hashField = document.getElementById('hashedPassword');

      if (!plain.trim()) {
        hashField.value = 'Please enter a password first.';
        return;
      }

      try {
        const response = await fetch('/generate-hash', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: plain })
        });
        const data = await response.json();
        if (data.success) {
          hashField.value = data.hash;
        } else {
          hashField.value = 'Error: ' + data.error;
        }
      } catch (error) {
        hashField.value = 'Error generating hash: ' + error.message;
      }
    });

    // Server shutdown modal
    const shutdownModal = document.getElementById('shutdownModal');
    const shutdownServerBtn = document.getElementById('shutdownServerBtn');
    const confirmShutdown = document.getElementById('confirmShutdown');
    const cancelShutdown = document.getElementById('cancelShutdown');

    shutdownServerBtn.addEventListener('click', () => {
      shutdownModal.style.display = 'flex';
    });

    cancelShutdown.addEventListener('click', () => {
      shutdownModal.style.display = 'none';
    });

    shutdownModal.addEventListener('click', (e) => {
      if (e.target === shutdownModal) {
        shutdownModal.style.display = 'none';
      }
    });

    confirmShutdown.addEventListener('click', async () => {
      confirmShutdown.disabled = true;
      confirmShutdown.textContent = 'Shutting down...';

      try {
        const response = await fetch('/shutdown', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
          alert('Node.js server is shutting down...');
          shutdownModal.style.display = 'none';
        } else {
          alert('Error: ' + data.error);
          confirmShutdown.disabled = false;
          confirmShutdown.textContent = 'Shutdown';
        }
      } catch (error) {
        alert('Error shutting down server: ' + error.message);
        confirmShutdown.disabled = false;
        confirmShutdown.textContent = 'Shutdown';
      }
    });
  </script>
</body>
</html>
