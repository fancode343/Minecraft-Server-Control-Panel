    <div><button class="btn-sendMSG" id="messageSRV">Send Message</button></div> <!-- Send MSG Button-->
    <div id="customModal12" class="custom-modal12">
      <div class="custom-modal-content">


        <h3 id="modalTitle">Send a Message</h3>
        <label><input type="radio" name="commandType" value="tellraw"> Tellraw</label>
  <label><input type="radio" name="commandType" value="title"> Title</label>
        </select>
        <textarea id="modalInput12" placeholder="Enter your message here..." rows="3" style="width: 100%; padding: 8px;"></textarea>
