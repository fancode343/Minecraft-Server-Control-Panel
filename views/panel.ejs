  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <style>
    #logs {
      width: 100%;
      height: 400px;
      overflow-y: scroll;
      background: #000;
      color: #0f0;
      padding: 10px;
      border: 1px solid #333;
      font-family: monospace;
    }
    #playerContainer {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .player {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .player-avatar {
      position: relative;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: url('https://i.pinimg.com/736x/3d/4a/5b/3d4a5b43754727abdcdf23e224545e7b.jpg') no-repeat center center;
      background-size: cover;
      cursor: pointer;
      border: 2px solid #333;
    }

    .player-name {
      margin-top: 5px;
      font-size: 12px;
      color: white;
      text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    }

    .context-menu {
      position: absolute;
      top: 50px;
      left: 0;
      background: #343a40;
      border-radius: 5px;
      display: none;
      flex-direction: column;
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
      z-index: 1000;
    }

    .context-menu button {
      background: transparent;
      border: none;
      color: white;
      padding: 10px;
      cursor: pointer;
      text-align: left;
      width: 100%;
    }

    .context-menu button:hover {
      background: #495057;
    }

    .status-indicator {
      position: absolute;
      bottom: 5px;
      right: 5px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 2px solid white;
    }

    /* Modal Styles */
    .custom-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      justify-content: center;
      align-items: center;
      z-index: 2000;
    }

    .custom-modal-content {
      background-color: #343a40;
      padding: 20px;
      border-radius: 8px;
      width: 300px;
      text-align: center;
      color: white;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

    .custom-modal-content h3 {
      margin-bottom: 15px;
    }

    .custom-modal-content input {
      width: 100%;
      padding: 8px;
      margin-bottom: 15px;
      border: 1px solid #495057;
      border-radius: 5px;
      background-color: #495057;
      color: white;
    }

    .custom-modal-content button {
      margin: 5px;
      padding: 8px 15px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
    }

    .custom-modal-content .btn-submit {
      background-color: #28a745;
      color: white;
    }

    .custom-modal-content .btn-submit:hover {
      background-color: #218838;
    }

    .custom-modal-content .btn-cancel {
      background-color: #dc3545;
      color: white;
    }

    .custom-modal-content .btn-cancel:hover {
      background-color: #c82333;
    }
    .custom-modal12 {
  display: none; /* Initially hidden */
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.5); /* Modal overlay */
}
.custom-modal-content {
  background: rgb(66, 66, 66);
  padding: 20px;
  border-radius: 5px;
  width: 300px;
}
.btn-sendMSG {
  font-size: 20px;
  box-shadow: 0 8px 16px 0 rgba(0,0,0,0.2), 0 6px 20px 0 rgba(0,0,0,0.19);
  border-radius: 12px;
  background-color:rgb(88, 255, 83)
}
  </style>
</head>
<body>
