

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="EPSTEINSMP PANEL">
    <link rel="shortcut icon" href="assets/logo.png" sizes="196x196" type="image/png">
    <meta name="description" content="EpsteinSMP ControlPanel, Control And Manage The Server">
    <meta name="author" content="EpsteinSMP">
    <meta name="robots" content="noindex, nofollow">
    <meta property="og:image" content="/assets/content.jpg">
    <meta name="googlebot" content="noindex">
    <meta property="og:site_name" content="EPSTIENSMP">
    <title>Control Panel</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="assets/chatAssets/chat.css">
  <style>
    #logs {
      width: 100%;
      height: 400px;
      overflow-y: scroll;
      background: #000;
      color: #0f0;
      padding: 10px;
      border: 1px solid #333;
      font-family: monospace;
    }
    #playerContainer {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .player {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .player-avatar {
      position: relative;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: url('https://i.pinimg.com/736x/3d/4a/5b/3d4a5b43754727abdcdf23e224545e7b.jpg') no-repeat center center;
      background-size: cover;
      cursor: pointer;
      border: 2px solid #333;
    }

    .player-name {
      margin-top: 5px;
      font-size: 12px;
      color: white;
      text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    }

    .context-menu {
      position: absolute;
      top: 50px;
      left: 0;
      background: #343a40;
      border-radius: 5px;
      display: none;
      flex-direction: column;
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
      z-index: 1000;
    }

    .context-menu button {
      background: transparent;
      border: none;
      color: white;
      padding: 10px;
      cursor: pointer;
      text-align: left;
      width: 100%;
    }

    .context-menu button:hover {
      background: #495057;
    }

    .status-indicator {
      position: absolute;
      bottom: 5px;
      right: 5px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 2px solid white;
    }

    /* Modal Styles */
    .custom-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      justify-content: center;
      align-items: center;
      z-index: 2000;
    }

    .custom-modal-content {
      background-color: #343a40;
      padding: 20px;
      border-radius: 8px;
      width: 300px;
      text-align: center;
      color: white;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

    .custom-modal-content h3 {
      margin-bottom: 15px;
    }

    .custom-modal-content input {
      width: 100%;
      padding: 8px;
      margin-bottom: 15px;
      border: 1px solid #495057;
      border-radius: 5px;
      background-color: #495057;
      color: white;
    }

    .custom-modal-content button {
      margin: 5px;
      padding: 8px 15px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
    }

    .custom-modal-content .btn-submit {
      background-color: #28a745;
      color: white;
    }

    .custom-modal-content .btn-submit:hover {
      background-color: #218838;
    }

    .custom-modal-content .btn-cancel {
      background-color: #dc3545;
      color: white;
    }

    .custom-modal-content .btn-cancel:hover {
      background-color: #c82333;
    }
    .custom-modal12 {
  display: none; /* Initially hidden */
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.5); /* Modal overlay */
}
.custom-modal-content {
  background: rgb(66, 66, 66);
  padding: 20px;
  border-radius: 5px;
  width: 300px;
}
.btn-sendMSG {
  font-size: 20px;
  box-shadow: 0 5px 16px 0 rgba(0,0,0,0.2), 0 6px 20px 0 rgba(0,0,0,0.19);
  border-radius: 6px;
  background-color:rgb(6, 199, 247)
}
@media (max-width: 400px) {
  .btn-success {
    background-color: #28a745;
    border-color: #28a745;
    font-size: 12px; 
    padding: 4px 8px;
  }
}
@media (max-width: 400px) {
  .btn-danger {
    background-color: #dc3545;
    border-color: #dc3545;
    font-size: 12px; 
    padding: 4px 8px;
  }
}
@media (max-width: 400px) {
  .btn-warning {
    background-color: #ffc107;
    border-color: #ffc107;
    font-size: 12px; 
    padding: 4px 8px;
  }
}
  </style>
</head>
<body>
<%- include("/home/lmnet/server/assets/nav") %> 


  <div class="container mt-5">
    <h1>Welcome, <%= username %>!</h1>
    <div class="btn-group mb-4">
      <div class="d-flex align-items-center">
        <button id="startButton" class="btn btn-success">Start Server</button>
        <div id="startSpinner" class="spinner-border text-success ml-2" role="status" style="display: none;"></div>
        <span id="startCheck" class="text-success ml-2" style="display: none;">✔</span>
      </div>
      <div class="d-flex align-items-center ml-3">
        <button id="restartButton" class="btn btn-warning">Restart Server</button>
        <div id="restartSpinner" class="spinner-border text-warning ml-2" role="status" style="display: none;"></div>
        <span id="restartCheck" class="text-success ml-2" style="display: none;">✔</span>
      </div>
      <div class="d-flex align-items-center ml-3">
        <button id="stopButton" class="btn btn-danger">Stop Server</button>
        <div id="stopSpinner" class="spinner-border text-danger ml-2" role="status" style="display: none;"></div>
        <span id="stopCheck" class="text-success ml-2" style="display: none;">✔</span>
      </div>
    </div>


    <h3>Players-Status</h3>
    <div id="playerContainer" class="mt-3 d-flex justify-content-start align-items-center"><h3 style="color: red;">Server is offline</h3></div>


    <h4>__________________________</h4>
    <h3>Send message to the server</h3>
    <div><button class="btn-sendMSG" id="messageSRV">Send Message</button></div> <!-- Send MSG Button-->
    <div id="customModal12" class="custom-modal12">
      <div class="custom-modal-content">


        <h3 id="modalTitle">Send a Message</h3>
        <label><input type="radio" name="commandType" value="tellraw"> Tellraw</label>
  <label><input type="radio" name="commandType" value="title"> Title</label>
        </select>
        <textarea id="modalInput12" placeholder="Enter your message here..." rows="3" style="width: 100%; padding: 8px;"></textarea>
        <div>
          <button class="btn-submit" id="submitModal12">Submit</button>
          <button class="btn-cancel" id="cancelModal12">Cancel</button>
        </div>
      </div>
    </div>
    <h4>__________________________</h4>
    <h3>Gamerule</h3>
<div id="gameruleSettings">
  <div class="form-group">
    <label for="keepInventory">keepInventory:</label>
    <select style="width: 200px;" id="keepInventory" class="form-control">
      <option style="width: 10%;" value="true">True</option>
      <option style="width: 10%;" value="false">False</option>
    </select>
  </div>

  <div class="form-group">
    <label for="playersSleepingPercentage">playersSleepingPercentage:</label>
    <input type="number" id="playersSleepingPercentage" class="form-control" style="width: 200px;" min="0" max="100" value="50">
  </div>

  <button id="submitGamerule" class="btn btn-primary">Submit</button>
</div>

<h4>__________________________</h4>
<h3>World Backup</h3>

<div class="form-group">
  <label for="backupOption">Choose Backup Option:</label>
  <select id="backupOption" class="form-control" style="width: 200px;">
    <option value="dayToDay">Select Option</option>
    <option value="dayToDay">DaytoDay</option>
    <option value="hours24">24hours</option>
  </select>
</div>

<div id="fileListContainer" style="margin-top: 10px;">
  <ul id="fileList" class="list-group"></ul>
</div>

<button id="submitBackup" class="btn btn-primary mt-3">Submit Backup</button>

<!-- Confirmation Modal -->
<div id="backupModal" class="custom-modal">
  <div class="custom-modal-content">
    <h3>Confirm Backup</h3>
    <p>Are you sure you want to backup this file? This action will stop the server.</p>
    <div id="progressText" style="display: none; color: white; margin-top: 10px;">Progressing...</div>
    <div>
      <button id="confirmBackup" class="btn btn-danger">Confirm</button>
      <button id="cancelBackup" class="btn btn-secondary">Cancel</button>
    </div>
  </div>
</div>


  </div>
 
  

  <!-- Modals -->
  <div id="customModal" class="custom-modal">
    <div class="custom-modal-content">
      <h3 id="modalTitle">Action Title</h3>
      <input type="text" id="modalInput" placeholder="Enter your input here..." />
      <div>
        <button class="btn-submit" id="submitModal">Submit</button>
        <button class="btn-cancel" id="cancelModal">Cancel</button>
      </div>
    </div>
  </div>

  <div class="modal fade" id="responseModal" tabindex="-1" aria-labelledby="responseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="responseModalLabel">Server Response</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body" id="responseModalBody"></div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!--Chat Container-->
  <div id="chatContainer" class="chat-container">
    <div class="chat-header">
      <h5>Chat</h5>
      <button id="closeChatButton" class="close-chat">✖</button>
    </div>
    <div id="chatMessages" class="chat-messages"></div>
    <div class="chat-input-container">
      <textarea id="chatInput" rows="2" placeholder="Type a message..."></textarea>
      <button id="sendMessageButton">Send</button>
    </div>
  </div>
  <button id="chatToggle" class="chat-toggle">💬</button>
  
<script>
 async function logActivity(action) {
  // Generate a UTC+8 timestamp
  const options = { timeZone: "Asia/Shanghai", hour12: false };
  const formatter = new Intl.DateTimeFormat("en-US", {
    ...options,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
  });

  const utc8Date = new Date();
  const [datePart, timePart] = formatter.format(utc8Date).split(", ");
  const [month, day, year] = datePart.split("/"); // Extract parts of the date
  const timestamp = `${year}-${month}-${day}T${timePart}+08:00`; // Format as ISO 8601

  const payload = {
    user: "<%= username %>", // Replace with dynamic username if needed
    action,
    timestamp,
  };

  console.log("Payload to be sent:", payload); // Debugging

  try {
    const response = await fetch("/activity-log", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
    });

    if (!response.ok) {
      const errorData = await response.json();
      console.error("Failed to log activity:", errorData.error);
    } else {
      console.log("Activity logged:", payload);
    }
  } catch (error) {
    console.error("Error logging activity:", error);
  }
}

</script>


  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // DOM elements
      const chatContainer = document.getElementById("chatContainer");
      const chatMessages = document.getElementById("chatMessages");
      const chatInput = document.getElementById("chatInput");
      const sendMessageButton = document.getElementById("sendMessageButton");
      const chatToggle = document.getElementById("chatToggle");
      const closeChatButton = document.getElementById("closeChatButton");
  
      // Username (replace with dynamic username logic if available)
      const username = "<%= username %>";
  
      // WebSocket connection
      const ws = new WebSocket("wss://gjrj.lmnet.cf/ws"); //note: change this to your server ip
  
      // Helper function to append a message to the chat
      function appendMessage(user, message) {
        if (!chatMessages) {
          console.error("Chat messages container not found.");
          return;
        }
        const messageElement = document.createElement("div");
        messageElement.textContent = `${user}: ${message}`;
        chatMessages.appendChild(messageElement);
        scrollToBottom(); // Automatically scroll to the bottom
      }
  
      // Helper function to scroll to the bottom of the chat
      function scrollToBottom() {
        if (chatMessages) {
          chatMessages.scrollTop = chatMessages.scrollHeight;
        }
      }
  
      // Send a message
      function sendMessage() {
        const message = chatInput.value.trim();
        if (message) {
          const payload = { user: username, message };
          ws.send(JSON.stringify(payload)); // Send the message
          chatInput.value = ""; // Clear input field
        }
      }
  
      // WebSocket event: Handle incoming messages
      ws.onmessage = (event) => {
        console.log("WebSocket message received:", event.data);
        let data;
        try {
          data = JSON.parse(event.data);
        } catch (error) {
          console.error("Invalid JSON received from WebSocket:", event.data);
          return;
        }
  
        if (data.type === "history") {
          chatMessages.innerHTML = ""; // Clear existing messages
          data.data.forEach((msg) => appendMessage(msg.user, msg.message));
          scrollToBottom(); // Scroll to the bottom after loading history
        } else if (data.type === "message") {
          appendMessage(data.data.user, data.data.message);
          if (chatContainer.style.display === "none") {
            chatToggle.classList.add("new-message"); // Highlight toggle if hidden
          }
        }
      };
  
      // WebSocket event: Log errors
      ws.onerror = (error) => {
        console.error("WebSocket error:", error);
      };
  
      // WebSocket event: Log disconnection
      ws.onclose = () => {
        console.warn("WebSocket connection closed.");
      };
  
      // Event listener: Send message on button click
      sendMessageButton.addEventListener("click", sendMessage);
  
      // Event listener: Send message on Enter key press
      chatInput.addEventListener("keypress", (event) => {
        if (event.key === "Enter" && !event.shiftKey) {
          event.preventDefault(); // Prevent newline in the textarea
          sendMessage(); // Send the message
        }
      });
  
      // Event listener: Toggle chat container visibility
      chatToggle.addEventListener("click", () => {
        chatContainer.style.display = "flex";
        chatToggle.style.display = "none"; // Hide chat toggle
        chatToggle.classList.remove("new-message"); // Remove notification styling
        scrollToBottom(); // Scroll to the bottom on opening
      });
  
      // Event listener: Close chat container
      closeChatButton.addEventListener("click", () => {
        chatContainer.style.display = "none";
        chatToggle.style.display = "block"; // Show chat toggle
      });
    });
  </script>
  
  
  
  
  

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

  <script src="/assets/SSR.js"></script> <!--SSR function-->

  <script>
    const backupOption = document.getElementById("backupOption");
    const fileListContainer = document.getElementById("fileListContainer");
    const fileList = document.getElementById("fileList");
    const submitBackup = document.getElementById("submitBackup");
    const backupModal = document.getElementById("backupModal");
    const confirmBackup = document.getElementById("confirmBackup");
    const cancelBackup = document.getElementById("cancelBackup");
    const progressText = document.createElement("div");

    progressText.id = "progressText";
    progressText.style.display = "none";
    progressText.style.color = "white";
    progressText.style.marginTop = "10px";
    progressText.textContent = "Progressing...";
    backupModal.querySelector(".custom-modal-content").appendChild(progressText);

    let selectedBackupType = null;
    let selectedFileId = null;
    let selectedFileName = null;

    // Fetch and display file list based on backup option
    backupOption.addEventListener("change", () => {
        const type = backupOption.value;
        selectedBackupType = type;

        fetch(`/api/files?type=${type}`)
            .then((response) => {
                if (!response.ok) {
                    throw new Error(`Error: ${response.statusText}`);
                }
                return response.json();
            })
            .then((files) => {
                // Populate the file list with file name and modified time
                fileList.innerHTML = files
                    .map(
                        (file) =>
                            `<li class="list-group-item" data-file-id="${file.id}" data-file-name="${file.name}" style="cursor: pointer;">
                                <strong>${file.name}</strong><br>
                                <small>Last Modified: ${file.modifiedTime}</small>
                            </li>`
                    )
                    .join("");
            })
            .catch((error) => {
                console.error("Error fetching files:", error);
                alert("Failed to fetch files. Please try again.");
            });
    });

    // Handle file selection
    fileList.addEventListener("click", (event) => {
        const listItem = event.target.closest("li");
        if (listItem) {
            // Highlight the selected file
            [...fileList.children].forEach((item) => item.classList.remove("active"));
            listItem.classList.add("active");

            // Store the selected file's ID and name
            selectedFileId = listItem.dataset.fileId;
            selectedFileName = listItem.dataset.fileName;
        }
        
    });

    // Show confirmation modal when "Submit Backup" is clicked
    submitBackup.addEventListener("click", () => {
        if (!selectedFileId || !selectedFileName) {
            alert("Please select a file to backup.");
            return;
        }
        backupModal.style.display = "flex";
    });

    // Send backup request to the server
    confirmBackup.addEventListener("click", () => {
        // Show the progressing text
        progressText.style.display = "block";

        logActivity(`Server Backup  - ${selectedBackupType}, ${selectedFileId}, ${selectedFileName} `)
        fetch("/api/backup", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                type: selectedBackupType,
                fileId: selectedFileId,
                fileName: selectedFileName,
            }),
        })
            .then((response) => {
                if (!response.ok) {
                    throw new Error(`Backup failed: ${response.statusText}`);
                }
                return response.text();
            })
            .then((result) => {
                alert(result);
                backupModal.style.display = "none";
            })
            .catch((error) => {
                console.error("Error:", error);
                alert("An error occurred during the backup process.");
            })
            .finally(() => {
                // Hide the progressing text
                progressText.style.display = "none";
            });
    });

    // Close confirmation modal
    cancelBackup.addEventListener("click", () => {
        backupModal.style.display = "none";
    });
</script>

  
  
  

  <script>
    document.getElementById("submitGamerule").addEventListener("click", () => {
    // Retrieve values from the inputs
    const keepInventory = document.getElementById("keepInventory").value;
    const playersSleepingPercentage = document.getElementById("playersSleepingPercentage").value;

    // Construct commands
    const commands = [
      `gamerule keepInventory ${keepInventory}`,
      `gamerule playersSleepingPercentage ${playersSleepingPercentage}`
    ];

    // Send commands to the server
    commands.forEach(command => {
      logActivity(`${command}`)
      fetch("/command", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `command=${encodeURIComponent(command)}`,
      })
        .then(response => response.text())
        .then(result => console.log(result))
        .catch(error => console.error("Error sending command:", error));
    });

    alert("Gamerule settings submitted!");
  });
  </script>
  <script>
    const messageButton12 = document.getElementById("messageSRV");
    const customModal12 = document.getElementById("customModal12");
    const submitModal12 = document.getElementById("submitModal12");
    const cancelModal12 = document.getElementById("cancelModal12");
    const modalInput12 = document.getElementById("modalInput12");
  
    // Open the modal
    messageButton12.addEventListener("click", () => {
      customModal12.style.display = "flex";
    });
  
    // Close the modal
    cancelModal12.addEventListener("click", () => {
      customModal12.style.display = "none";
      modalInput12.value = "";
    });
  
    // Submit the message
    submitModal12.addEventListener("click", () => {
      // Get selected command type
      const commandTypeElement = document.querySelector('input[name="commandType"]:checked');
      if (!commandTypeElement) {
        alert("Please select a command type!");
        return;
      }
      const commandType = commandTypeElement.value;
      if (!commandType) {
        alert("Please select a command type!");
        return;
      }
  
      // Get message input
      const message = modalInput12.value.trim();
      if (!message) {
        alert("Message cannot be empty!");
        return;
      }
  
      // Construct the server command
      let serverCommand;
      if (commandType === "tellraw") {
        serverCommand = `tellraw @a {"rawtext":[{"text":"${message}"}]}`;
      } else if (commandType === "title") {
        serverCommand = `title @a title ${message}`;
      } else {
        alert("Invalid command type selected!");
        return;
      }
  
      // Send command to the server
      logActivity(`${serverCommand}`)
      fetch("/command", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `command=${encodeURIComponent(serverCommand)}`,
      })
        .then((response) => {
          console.log("Fetch Response Status:", response.status); // Debugging
          return response.text();
        })
        .then((result) => {
          console.log("Server Response:", result); // Debugging
          showModal(result);
        })
        .catch((error) => {
          console.error("Error:", error);
          showModal("An error occurred while processing your command.");
        });
  
      // Close the modal and reset inputs
      customModal12.style.display = "none";
      modalInput12.value = "";
    });
  
    // Function to show the server response
    function showModal(message) {
      alert(message); // Replace with a custom modal if needed
    }
  </script>



  
  

<script>
  document.addEventListener("DOMContentLoaded", () => {
 const playerContainer = document.getElementById("playerContainer");

 // Modal variables
 const modal = document.getElementById("customModal");
 const modalTitle = document.getElementById("modalTitle");
 const modalInput = document.getElementById("modalInput");
 const submitButton = document.getElementById("submitModal");
 const cancelButton = document.getElementById("cancelModal");

 let currentAction = null;
 let currentPlayer = null;

 // Show the custom modal
 function showModal(action, playerName) {
   currentAction = action;
   currentPlayer = playerName;

   if (action === "kick") {
     modalTitle.textContent = `Kick ${playerName}`;
     modalInput.placeholder = "Enter the reason for kicking...";
   } else if (action === "message") {
     modalTitle.textContent = `Message ${playerName}`;
     modalInput.placeholder = "Enter your message...";
   } else if (action === "teleport") {
     modalTitle.textContent = `teleport ${playerName}`;
     modalInput.placeholder = "Enter Player or Coordinates X Y Z";
   }

   modalInput.value = "";
   modal.style.display = "flex";
 }

 // Handle modal submit
 function handleModalSubmit() {
   const inputValue = modalInput.value.trim();
   if (!inputValue) {
     alert("Input cannot be empty.");
     return;
   }

   if (currentAction === "kick") {
     handleCommand(`kick "${currentPlayer}"" ${inputValue}`);
     logActivity(`kicked ${currentPlayer} Reason: ${inputValue}`);
   } else if (currentAction === "message") {
     handleCommand(`title "${currentPlayer}" title ${inputValue}`);
     logActivity(`Message ${currentPlayer}, ${inputValue}`)
   } else if (currentAction === "teleport") {
     logActivity(`Teleport ${currentPlayer} to ${inputValue}`)
     handleCommand(`tp "${currentPlayer}" ${inputValue}`);
   }
   closeModal();
 }

 // Close the modal
 function closeModal() {
   modal.style.display = "none";
   currentAction = null;
   currentPlayer = null;
 }

 // Attach event listeners to modal buttons
 submitButton.addEventListener("click", handleModalSubmit);
 cancelButton.addEventListener("click", closeModal);

 // Close the modal on outside click
 window.addEventListener("click", (event) => {
   if (event.target === modal) {
     closeModal();
   }
 });

 // Fetch the player list from the server
 async function fetchPlayerList() {
   try {
     const response = await fetch("/getPlayers");
     if (response.ok) {
       const playerList = await response.json();
       updatePlayerList(playerList);
     } else {
       console.error("Failed to fetch player list:", response.statusText);
     }
   } catch (error) {
     console.error("Error fetching player list:", error);
   }
 }

 // Update the player list and re-render the UI
 function updatePlayerList(playerList) {
   playerContainer.innerHTML = ""; // Clear the container
   playerList.forEach((player) => {
     const playerWrapper = document.createElement("div");
     playerWrapper.className = "player";

     const avatar = document.createElement("div");
     avatar.className = "player-avatar";
     avatar.style.backgroundImage =
       "url('https://i.pinimg.com/736x/3d/4a/5b/3d4a5b43754727abdcdf23e224545e7b.jpg')";

     const statusIndicator = document.createElement("div");
     statusIndicator.className = "status-indicator";
     statusIndicator.style.backgroundColor =
       player.status === "connected" ? "green" : "red";

     const contextMenu = document.createElement("div");
     contextMenu.className = "context-menu";

     if (player.status === "connected") {
       const kickButton = document.createElement("button");
       kickButton.innerText = "Kick";
       kickButton.onclick = () => showModal("kick", player.name);
       contextMenu.appendChild(kickButton);

       const opButton = document.createElement("button");
       opButton.innerText = "Op";
       opButton.onclick = () => handleCommand(`op "${player.name}"`);
       contextMenu.appendChild(opButton);

       const deopButton = document.createElement("button");
       deopButton.innerText = "Deop";
       deopButton.onclick = () => handleCommand(`deop "${player.name}"`);
       contextMenu.appendChild(deopButton);

       const messageButton = document.createElement("button");
       messageButton.innerText = "Message";
       messageButton.onclick = () => showModal("message", player.name);
       contextMenu.appendChild(messageButton);

       const killButton = document.createElement("button");
       killButton.innerText = "kill";
       killButton.onclick = () => handleCommand(`kill "${player.name}"`);
       contextMenu.appendChild(killButton);

       const DeAllowButton = document.createElement("button");
       DeAllowButton .innerText = "De-Allowlist"; 
       DeAllowButton .onclick = () => handleCommand(`allowlist remove "${player.name}"`); 
       contextMenu.appendChild(DeAllowButton);

       const tpButton = document.createElement("button");
       tpButton.innerText = "teleport";
       tpButton.onclick = () => showModal("teleport", player.name);
       contextMenu.appendChild(tpButton);
     } else {
       const messageButton = document.createElement("button");
       messageButton.innerText = "Offline";
       contextMenu.appendChild(messageButton);
     }

     avatar.appendChild(contextMenu);
     avatar.appendChild(statusIndicator);

     avatar.addEventListener("click", (e) => {
       e.stopPropagation();
       document
         .querySelectorAll(".context-menu")
         .forEach((menu) => (menu.style.display = "none"));
       contextMenu.style.display =
         contextMenu.style.display === "block" ? "none" : "block";
     });

     const playerName = document.createElement("div");
     playerName.className = "player-name";
     playerName.innerText = player.name;

     playerWrapper.appendChild(avatar);
     playerWrapper.appendChild(playerName);
     playerContainer.appendChild(playerWrapper);
   });
 }

 function handleCommand(command) {
   logActivity(`${command}`)
   fetch("/command", {
     method: "POST",
     headers: { "Content-Type": "application/x-www-form-urlencoded" },
     body: `command=${encodeURIComponent(command)}`, 
   })
     .then((response) => response.text())
     .catch((error) => console.error("Error sending command:", error));
 }

 fetchPlayerList();
 setInterval(fetchPlayerList, 5000);

 document.addEventListener("click", () => {
   document
     .querySelectorAll(".context-menu")
     .forEach((menu) => (menu.style.display = "none"));
 });

});

 </script>
</body>
</html>
