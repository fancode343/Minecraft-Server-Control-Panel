  <script>
document.addEventListener("DOMContentLoaded", () => {
  const playerContainer = document.getElementById("playerContainer");

  // Fetch the allowlist from the server
  async function fetchAllowlist() {
    try {
      const response = await fetch("/getAllowlist");
      if (response.ok) {
        const allowlist = await response.json();
        updatePlayerList(allowlist);
      } else {
        console.error("Failed to fetch allowlist:", response.statusText);
      }
    } catch (error) {
      console.error("Error fetching allowlist:", error);
    }
  }

  // Update the player list based on allowlist
  function updatePlayerList(allowlist) {
    playerContainer.innerHTML = ""; // Clear the container
    allowlist.forEach((player) => {
      const playerWrapper = document.createElement("div");
      playerWrapper.className = "player";

      const avatar = document.createElement("div");
      avatar.className = "player-avatar";
      avatar.style.backgroundImage = "url('https://i.pinimg.com/736x/3d/4a/5b/3d4a5b43754727abdcdf23e224545e7b.jpg')";

      const statusIndicator = document.createElement("div");
      statusIndicator.className = "status-indicator";
      statusIndicator.style.backgroundColor = "green"; // All players on allowlist are presumed "connected"

      const playerName = document.createElement("div");
      playerName.className = "player-name";
      playerName.textContent = player.name; // Assuming the JSON has a `name` field

      playerWrapper.appendChild(avatar);
      avatar.appendChild(statusIndicator);
      playerWrapper.appendChild(playerName);
      playerContainer.appendChild(playerWrapper);
    });
  }

  // Fetch allowlist on page load
  fetchAllowlist();
});


  </script>
  
  
  
  
  

