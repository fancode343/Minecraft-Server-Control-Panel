<h3>Allowlist</h3>
<div id="AllowlistP">
  <div class="form-group">
    <label for="Allowlist">Allowlist:</label>
     <select style="width: 200px;" id="allowlist" class="form-control">
    <option style="width: 10%;" value="add">Add</option>
    <option style="width: 10%;" value="remove">Remove</option>
</select>
</div>
<div class="form-group">
  <label for="Gamertag">Gamertag:</label>
  <input type="playerAllow" id="playerallow" class="form-control" style="width: 200px;" min="0" max="100" value="Player">
  </div>
  <button id="submitAllowlist" class="btn btn-primary">Submit</button>
</div>

<div id="playerContainer">
  <!-- Player cards will be dynamically added here -->
</div>

<script>
 document.getElementById("submitAllowlist").addEventListener("click", () => {
  // Retrieve values from the inputs
  const value1 = document.getElementById("allowlist").value;
  const player = document.getElementById("playerallow").value;

  // Construct commands
  const commands = [`allowlist ${value1} ${player}`];

  // Send commands to the server
  commands.forEach((command) => {
    logActivity(`${command}`);
    fetch("/command", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: `command=${encodeURIComponent(command)}`,
    })
      .then((response) => response.text())
      .then((result) => {
        console.log(result);
        alert("Allowlist submitted!");
        window.location.reload(); // Refresh the page
      })
      .catch((error) => console.error("Error sending command:", error));
  });
});
</script>

