<script>
 document.getElementById("submitAllowlist").addEventListener("click", () => {
  // Retrieve values from the inputs
  const value1 = document.getElementById("allowlist").value;
  const player = document.getElementById("playerallow").value;

  // Construct commands
  const commands = [`allowlist ${value1} ${player}`];

  // Send commands to the server
  commands.forEach((command) => {
    logActivity(`${command}`);
    fetch("/command", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: `command=${encodeURIComponent(command)}`,
    })
      .then((response) => response.text())
      .then((result) => {
        console.log(result);
        alert("Allowlist submitted!");
        window.location.reload(); // Refresh the page
      })
      .catch((error) => console.error("Error sending command:", error));
  });
});
</script>

