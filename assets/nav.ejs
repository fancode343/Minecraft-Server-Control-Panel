  <style>
    .navbar {
      min-height: 56px !important;
      height: auto !important;
      padding: 0.5rem 0 !important;
    }

    .nav-link {
      position: relative;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      color: rgba(255, 255, 255, 0.7) !important;
      margin: 0 4px;
      padding: 8px 14px !important;
      border-radius: 10px;
    }

    .nav-link:hover {
      color: rgba(255, 255, 255, 1) !important;
      background: rgba(148, 163, 184, 0.1);
      transform: translateY(-2px);
    }

    .nav-link.active {
      color: white !important;
      background: rgba(102, 126, 234, 0.2) !important;
      border: 1.5px solid rgba(102, 126, 234, 0.6) !important;
      box-shadow: 0 0 12px rgba(102, 126, 234, 0.3), inset 0 0 8px rgba(102, 126, 234, 0.1);
      font-weight: 600;
      animation: tabPulse 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .nav-link.active::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
      pointer-events: none;
    }

    @keyframes tabPulse {
      0% {
        transform: scale(0.95);
        opacity: 0.8;
      }
      50% {
        transform: scale(1.02);
      }
      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .navbar-collapse {
      animation: fadeIn 0.4s ease-out;
    }
  </style>

  <nav class="navbar navbar-expand-lg navbar-dark fixed-top mb-4" style="background: rgba(10, 18, 30, 0.86); border-bottom: 1px solid rgba(148, 163, 184, 0.14); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);">
    <div class="container" style="max-width: 1400px;">
      <a class="navbar-brand d-flex align-items-center" href="#" style="font-weight: 700; letter-spacing: 0.02em; color: #f8fbff;">
        <img src="assets/logo.png" alt="Logo" style="width: 28px; height: 28px; border-radius: 8px; margin-right: 10px;">
        <%= serverName || "Minecraft Server" %>
      </a>
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav mr-auto">
          <li class="nav-item"><a class="nav-link" href="/dashboard" data-page="dashboard">Panel</a></li>
          <li class="nav-item"><a class="nav-link" href="/Allowlist" data-page="allowlist">Allowlist</a></li>
          <li class="nav-item"><a class="nav-link" href="/bots-panel" data-page="bots">Bots</a></li>
          <li class="nav-item"><a class="nav-link" href="/command-center" data-page="command">Command</a></li>
          <li class="nav-item"><a class="nav-link" href="/editserver-properties" data-page="properties">Edit Server Properties</a></li>
          <li class="nav-item"><a class="nav-link" href="/server-info" data-page="info">Server Info</a></li>
          <li class="nav-item"><a class="nav-link" href="/activitylogs" data-page="logs">Panel Logs</a></li>
        </ul>
        <ul class="navbar-nav ml-auto">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <i class="fa fa-user-circle"></i> <%= username %>
            </a>
            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown" style="background: rgba(15,23,42,0.98); border: 1px solid rgba(148,163,184,0.2); border-radius: 12px; box-shadow: 0 18px 30px rgba(2,6,23,0.5);">
              <a class="dropdown-item text-white" href="/dashboard?p=&settings=1">Settings</a>
              <a class="dropdown-item text-white" href="?p=&help=2">Help</a>
              <a class="dropdown-item text-white" href="/logout">Sign Out</a>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const navLinks = document.querySelectorAll('.nav-link[data-page]');
      const currentPath = window.location.pathname.toLowerCase();

      navLinks.forEach(link => {
        const href = link.getAttribute('href').toLowerCase();
        
        // Match current page with nav link
        if (currentPath === href || currentPath.startsWith(href.replace(/\/$/, ''))) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }

        // Add click animation
        link.addEventListener('click', function(e) {
          navLinks.forEach(l => l.classList.remove('active'));
          this.classList.add('active');
        });
      });
    });
  </script>